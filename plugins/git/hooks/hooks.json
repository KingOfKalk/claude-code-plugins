{
  "description": "git-guard: block git -C, commits/pushes on protected branches, pushes to non-origin remotes and AI attribution; validate commit messages after commit",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh\" pre"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create|update)_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.sh\" post"
          }
        ]
      }
    ]
  }
}
